# Example environment variables for local development
# Copy this file to .env and fill in your values

# Domains (comma-separated)
DOMAINS="example.com,*.example.com,api.example.com"

# Email for Let's Encrypt registration
CERTBOT_EMAIL="admin@example.com"

# DNS Provider (cloudflare, route53, google, azure, digitalocean, linode, ovh, rfc2136)
DNS_PROVIDER="cloudflare"

# Certificate name (optional, defaults to letsencrypt-cert)
CERT_NAME="letsencrypt-cert"

# ──────────────────────────────────────────────────────────────
# Provider-specific credentials
# Only fill in the credentials for your chosen provider
# ──────────────────────────────────────────────────────────────

# ── Cloudflare ──────────────────────────────────────────────
# CF_Token="your-cloudflare-api-token-here"
# CF_Zone_ID="your-cloudflare-zone-id-here"

# ── AWS Route53 ─────────────────────────────────────────────
# AWS_ACCESS_KEY_ID="your-aws-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# ── Google Cloud DNS ────────────────────────────────────────
# GOOGLE_CREDENTIALS="/path/to/your/service-account.json"

# ── Azure DNS ───────────────────────────────────────────────
# AZURE_CLIENT_ID="your-azure-client-id"
# AZURE_CLIENT_SECRET="your-azure-client-secret"
# AZURE_TENANT_ID="your-azure-tenant-id"
# AZURE_SUBSCRIPTION_ID="your-azure-subscription-id"

# ── DigitalOcean ────────────────────────────────────────────
# DO_API_TOKEN="your-digitalocean-api-token"

# ── Linode ──────────────────────────────────────────────────
# LINODE_API_TOKEN="your-linode-api-token"

# ── OVH ─────────────────────────────────────────────────────
# OVH_APPLICATION_KEY="your-ovh-application-key"
# OVH_APPLICATION_SECRET="your-ovh-application-secret"
# OVH_CONSUMER_KEY="your-ovh-consumer-key"

# ── RFC 2136 ────────────────────────────────────────────────
# RFC2136_NAMESERVER="ns1.example.com"
# RFC2136_CREDENTIALS="/path/to/tsig-key.conf"